HEVY_API_KEY=your_hevy_api_key_here
HEVY_WEBHOOK_SECRET=your_hevy_webhook_secret_here
HEVY_POLL_INTERVAL_SECONDS=300
STRAVA_CLIENT_ID=your_strava_client_id_here
STRAVA_CLIENT_SECRET=your_strava_client_secret_here
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=
STRAVA_EXPIRES_AT=
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback
FITBIT_CLIENT_ID=your_fitbit_client_id_here
FITBIT_CLIENT_SECRET=your_fitbit_client_secret_here
WITHINGS_CLIENT_ID=your_withings_client_id_here
WITHINGS_CLIENT_SECRET=your_withings_client_secret_here
# Withings does not accept localhost callback URLs in normal developer apps.
# Use the deployed Railway backend callback or an HTTPS tunnel for local OAuth testing.
WITHINGS_REDIRECT_URI=https://api-production-b3ff.up.railway.app/api/withings/callback
OPENAI_API_KEY=your_openai_api_key_here
# OpenAI model for free-text food analysis. Defaults to gpt-4.1 for accuracy.
# Set to a cheaper model (e.g. gpt-4.1-mini) to reduce cost.
FOOD_ANALYSIS_MODEL=gpt-4.1
USDA_FDC_API_KEY=your_usda_fooddata_central_api_key_here
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here

# Frontend private access gate. These are server-side only; do not prefix them with NEXT_PUBLIC.
# For local Next.js development, put these in frontend/.env.local or pass them to npm run dev.
APP_PASSWORD=
SESSION_SECRET=8f3d1b0a9e7c4f6d2a1c8b5e9f0d7c6a4b2e1f9d8c7b6a5e4f3d2c1b0a9e8f7

# Public app URL used for OAuth callbacks and deployment docs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Next.js frontend API URL. This value is safe to expose because it is only the public backend URL.
# On Vercel, prefer server-side BACKEND_API_URL below and leave this blank unless you need direct browser-to-API calls.
NEXT_PUBLIC_API_URL=http://localhost:8001

# Legacy frontend fallback used by older local builds.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# Server-only backend proxy target for the Vercel frontend. Do not prefix this with NEXT_PUBLIC.
BACKEND_API_URL=http://localhost:8001

# Backend CORS. In production, set this to your Vercel frontend URL.
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Production database. Required for deployed data persistence across devices and redeploys.
DATABASE_URL=postgresql://postgres.mqqjmldnxgucreeuqkic:[YOUR-PASSWORD]@aws-1-us-west-1.pooler.supabase.com:6543/postgres

# Backend storage fallback. Local default is ./data. Do not rely on this for Vercel/serverless persistence.
PERFORMANCE_OS_DATA_DIR=

test

