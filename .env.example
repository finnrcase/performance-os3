HEVY_API_KEY=your_hevy_api_key_here
HEVY_WEBHOOK_SECRET=your_hevy_webhook_secret_here
HEVY_POLL_INTERVAL_SECONDS=300
STRAVA_CLIENT_ID=your_strava_client_id_here
STRAVA_CLIENT_SECRET=your_strava_client_secret_here
STRAVA_ACCESS_TOKEN=
FITBIT_CLIENT_ID=your_fitbit_client_id_here
FITBIT_CLIENT_SECRET=your_fitbit_client_secret_here
WITHINGS_CLIENT_ID=your_withings_client_id_here
WITHINGS_CLIENT_SECRET=your_withings_client_secret_here
OPENAI_API_KEY=your_openai_api_key_here
USDA_FDC_API_KEY=your_usda_fooddata_central_api_key_here
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here

# Frontend access gate. Leave empty locally if you do not want the gate enabled.
APP_ACCESS_PASSWORD=choose_a_private_password

# Public app URL used for OAuth callbacks and deployment docs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Next.js frontend API URL. This value is safe to expose because it is only the public backend URL.
# On Vercel, prefer server-side BACKEND_API_URL below and leave this blank unless you need direct browser-to-API calls.
NEXT_PUBLIC_API_URL=http://localhost:8001

# Legacy frontend fallback used by older local builds.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# Server-only backend proxy target for the Vercel frontend. Do not prefix this with NEXT_PUBLIC.
BACKEND_API_URL=http://localhost:8001

# Backend CORS. In production, set this to your Vercel frontend URL.
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Backend storage. Local default is ./data. In production, set this to a persistent mounted volume.
PERFORMANCE_OS_DATA_DIR=

# Reserved for a future durable database migration. The current backend uses CSV/JSON files in PERFORMANCE_OS_DATA_DIR.
DATABASE_URL=
