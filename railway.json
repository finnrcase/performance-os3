{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "sh -c 'DASHBOARD_CORE_BLOCK_TIMEOUT_MS=3000 DASHBOARD_CORE_DB_TIMEOUT_MS=2500 uvicorn backend.main:app --host 0.0.0.0 --port $PORT'",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300
  }
}
